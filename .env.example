# Copie ce fichier en ".env" (même dossier) et remplis les valeurs avec
# celles de ton projet Firebase (voir le README, section "Mode en ligne").
# Sans ce fichier rempli, le mode en ligne (création/rejoindre un salon)
# ne fonctionnera pas.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
